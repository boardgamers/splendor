{
  "name": "splendor-engine",
  "version": "0.1.0",
  "description": "Unofficial Splendor rules engine for boardgamers.space",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wrapper": {
      "types": "./dist/wrapper.d.ts",
      "default": "./dist/wrapper.js"
    },
    "./wrapper.js": {
      "types": "./dist/wrapper.d.ts",
      "default": "./dist/wrapper.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "tsc": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/src/*.spec.js\""
  },
  "dependencies": {
    "seedrandom": "3.0.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/seedrandom": "3.0.8",
    "typescript": "5.9.3"
  }
}
